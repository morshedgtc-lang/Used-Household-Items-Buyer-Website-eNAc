# Railway auto-injects DATABASE_URL when you add a PostgreSQL service.
# No manual database setup required.

# Required — Railway sets this automatically from its PostgreSQL plugin.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Required — generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Production URL (used for canonical links, sitemap, og tags).
NEXT_PUBLIC_SITE_URL="https://your-domain.up.railway.app"

# Optional: Supabase for image storage in the admin panel.
# If left empty, image uploads fall back to data-URLs (dev only).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# Initial admin account created by the seed script.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"
